{
  "manifest_version": 3,
  "name": "図書館蔵書チェッカー",
  "version": "1.0.0",
  "description": "Amazon・楽天ブックスの書籍ページで図書館の蔵書状況を確認できます",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.amazon.co.jp/*",
    "https://books.rakuten.co.jp/*",
    "https://api.calil.jp/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/*",
        "https://books.rakuten.co.jp/*"
      ],
      "js": ["content/content_script.js"],
      "css": ["content/content_script.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
